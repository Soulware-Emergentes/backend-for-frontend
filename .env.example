# Copy to .env and fill in. Bun reads .env on its own.

# Where it listens, and its address as browsers reach it. In development that is `ng serve`, which
# proxies /bff and /api here, so the session cookie belongs to the SPA's own origin.
PORT='8090'
BFF_PUBLIC_URL='http://localhost:4200'

# Staff, and the client this deployment is registered as there (staff's dev seed V103).
STAFF_ISSUER='http://localhost:8082'
BFF_CLIENT_ID='sgt-bff-dev'
BFF_CLIENT_SECRET='sgt-bff-dev-secret'

# Each API, and the scope its token is asked for under.
SGT_API='http://localhost:8080/api/v1'
SGT_SCOPE='openid profile sgt-api-dev'
BENEFICIARIOS_API='http://localhost:8081/api/v1'
BENEFICIARIOS_SCOPE='beneficiarios-api-dev'

# How long a login lasts at most: the same as staff's STAFF_SESSION_MAX.
SESSION_MAX='9h'

# Cookies only over HTTPS. false only on plain http://localhost.
SECURE_COOKIES='false'

# The built SPA, when this deployment serves it. Leave empty in development.
STATIC_DIR=''
